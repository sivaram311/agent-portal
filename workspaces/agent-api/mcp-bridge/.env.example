# MCP listen port — DEV 3430 | PREPROD 4430 | PROD 5430
PORT=5430

# Public path prefix (nginx location). Spark URL = https://agent-portal.delena.buzz/mcp/sse
MCP_BASE_PATH=/mcp

# Agent Portal API (PROD local upstream)
PORTAL_URL=http://127.0.0.1:5080

# Prefer API key if portal has AGENT_PORTAL_API_KEY set; otherwise CSS login:
# PORTAL_API_KEY=

# CSS login (required on PROD today — apiKeyFallbackEnabled=false)
CSS_AUTH_URL=https://agent-portal.delena.buzz
CSS_CLIENT_ID=agent-portal
CSS_USERNAME=admin
CSS_PASSWORD=

# Optional: require Spark to send this Bearer (or use OAuth below)
# MCP_BEARER_TOKEN=

# OAuth client credentials for Gemini Spark Advanced settings
MCP_OAUTH_CLIENT_ID=agent-portal-spark
MCP_OAUTH_CLIENT_SECRET=change-me-long-random
MCP_PUBLIC_BASE=https://agent-portal.delena.buzz/mcp

MCP_REQUIRE_OAUTH=false

DEFAULT_WORKSPACE=agent-api
DEFAULT_PROVIDER=cursor

# Wait-for-idle (send_prompt / machine_chat). timeoutMs wins over maxAttempts.
# Recommended for external MCP clients (Grok/Spark): 90000
MCP_WAIT_TIMEOUT_MS=90000
# MCP_WAIT_INTERVAL_MS=1000
# MCP_WAIT_MAX_ATTEMPTS=300

# Fail-fast for portal accept (POST /api/machine/chat and /prompt). A cold ACP session start can
# take ~12-14s on hosts with slow Cursor-cloud round trips (session/new fetching the model
# catalog) — keep this at or above the portal's agent.cursor.start-timeout-seconds +
# start-watchdog-buffer-seconds. Cached/healthy sessions reuse and stay near-instant.
MCP_PORTAL_ACCEPT_TIMEOUT_MS=15000
